# Copy this file to server/.env for local persistent database use.
PORT=4000
NODE_ENV=development
APP_TIMEZONE=Asia/Kolkata

# Generate a long random value before production.
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas connection string. Keep the database name at the end.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hearcare_pro?retryWrites=true&w=majority

# First real admin account. It is created ONLY when the User collection is empty.
INITIAL_ADMIN_NAME=Dr. Raghavendra
INITIAL_ADMIN_EMAIL=admin@yourclinicdomain.com
INITIAL_ADMIN_PASSWORD=CHANGE-THIS-TO-A-STRONG-PASSWORD

# Local frontend URL. On Render, change to your deployed Vercel/portal URL.
FRONTEND_URL=http://localhost:3000

# Leave false for real clinic data. true is only for a temporary demo database.
SEED_DEMO_DATA=false
